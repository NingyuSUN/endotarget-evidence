manifest {
    name = 'EndoTarget discovery'
    nextflowVersion = '=25.10.2'
}
params {
    counts = 'data/processed/discovery/counts_stable.tsv.gz'
    design = 'reports/final_clinical_design_discovery_primary.tsv'
    clinical = 'manifests/final_discovery_clinical_selected.tsv'
    edges = 'data/reference/string/direct_evidence_gene_edges.tsv.gz'
    stat_config = 'config/statistical_analysis.json'
    rank_config = 'config/ranking_algorithm.json'
    pre_effect_freeze = null
    synthetic_test = false
    outdir = null
    runtime_mode = 'native'
    container_image = null
}
workDir = "${projectDir}/work/nextflow"
process {
    executor = 'local'
    shell = ['/bin/bash', '-euo', 'pipefail']
    cpus = 1
    memory = '4 GB'
    maxForks = 1
    errorStrategy = 'terminate'
    cache = 'deep'
    stageInMode = 'symlink'
}
executor.queueSize = 1
profiles {
    srv01 {
        params.runtime_mode = 'native'
        docker.enabled = false
    }
    // DESIGN ONLY: daemon/image execution remains unverified.
    docker {
        params.runtime_mode = 'docker'
        docker.enabled = true
        docker.runOptions = "-v ${projectDir}:${projectDir}:ro"
        process.container = { params.container_image }
        process.containerOptions = { "-v ${task.workDir}:${task.workDir}:rw" }
    }
}
