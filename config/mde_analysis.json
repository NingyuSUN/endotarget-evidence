  "family_size_definition": "all expression-pass genes of the fit (the v1 BH adjustment denominator)",
  "mde_solver": {"method": "uniroot on the two-sided noncentral-t rejection probability", "tolerance": 1e-08, "approximation_check_column": "(qt(1-alpha/2,df)+qt(power,df))*SE"},
  "mde_summary_quantiles": [0.05, 0.1, 0.25, 0.5, 0.75, 0.9, 0.95],
  "mde_at_most_log2": [0.25, 0.5, 0.585, 1.0, 2.0],
  "ci_containment_log2_thresholds": [0.25, 0.5, 0.585, 1.0, 2.0],
  "ci_levels": {"per_gene": 0.95, "family_bonferroni": 0.95},
