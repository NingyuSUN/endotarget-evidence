      "cohort": "heca",
      "coefficient": "ENDO_minus_non_ENDO",
      "model": "work/statistical/heca_primary/de/model.rds",
      "model_sha256": "10306b806a875d9bb42f699bfcc8851d39c3282d4705f5f7d215775364daa174",
      "model_sha256_source": "receipts/heca_primary_execution.json:output_sha256"
    },
    "phase_discovery": {
