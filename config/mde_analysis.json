      "top_list": "full-cohort top-20 by |moderated t| among estimable genes"
    },
    "metrics": ["n_sig", "n_sig_up", "n_sig_down", "recall_full", "recall_full_any_sign", "sign_disagreement", "top20_overlap", "typical_mde_alpha_0.05", "typical_mde_bh_k100", "median_se", "median_df_total", "family_size", "estimable_genes", "residual_df", "rank", "n_batch_levels", "dropped_constant_nuisance"],
    "typical_gene_mde": "exact noncentral-t MDE at the median SE and median df_total of the draw's estimable genes; bh_k100 uses alpha = 0.05*100/family_size of the draw",
    "identity_check": {
      "required": true,
      "description": "the subsampling estimator on all donors with the primary design must reproduce the frozen full-cohort table before any subsample is fitted",
      "tolerance_logFC": 1e-08,
      "tolerance_t": 1e-06,
      "tolerance_log10_p": 1e-06
    },
    "summary_percentiles": [0.025, 0.5, 0.975],
    "quantile_type": 7,
    "max_workers": 12
  },
  "bridge": {
    "phase_program": "phase fit genes with BH q<0.05 (estimable)",
    "disease_mde_reference_scenarios": ["alpha_0.05", "bh_k100"],
    "statistics": [
      "share of phase-program genes whose |log2FC| exceeds the disease fit's median MDE under each reference scenario",
      "gene-matched: among phase-program genes present in the disease family, share whose phase |log2FC| exceeds that gene's own disease MDE under each scenario",
      "median |log2FC| of the phase program"
    ],
    "descriptive_only": true
  },
  "outputs": {
    "work_root": "work/mde_analysis",
