  "protocol": "docs/MDE_ANALYSIS_PROTOCOL.md",
  "purpose": "minimum detectable effect bounds from the saved v1 fits and a donor-subsampling sensitivity curve on the phase positive-control signal; no disease model is fitted; no v1 or positive-control artifact is modified",
  "estimator_config": "config/statistical_analysis.json",
