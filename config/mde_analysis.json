  },
  "subsampling": {
    "counts": {
      "discovery": "data/processed/phase_positive_control/discovery/counts_stable.tsv.gz",
      "heca": "data/processed/phase_positive_control/heca/counts_stable.tsv.gz"
    },
    "clinical": {
      "discovery": "data/processed/phase_positive_control/discovery/selected_donor_count_ledger.tsv",
      "heca": "data/processed/phase_positive_control/heca/selected_donor_count_ledger.tsv"
    },
    "input_hash_sources": {
