      "coefficient": "ENDO_minus_non_ENDO",
      "expected_rows": 17733
    },
    "heca": {
      "path": "reports/mde_analysis/v1_heca_mde_per_gene.tsv.gz",
      "sha256": "4912a9b057d736dc5be6870c33f2711dbebda2d9a027c6093756b17d68774b8c",
      "coefficient": "ENDO_minus_non_ENDO",
      "expected_rows": 17643
