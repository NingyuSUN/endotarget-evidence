manifest {
    name='EndoTarget independent replication'
    nextflowVersion='=25.10.2'
}
params {
    counts='data/processed/heca/counts_stable.tsv.gz'
    design='reports/final_clinical_design_heca_primary.tsv'
    clinical='manifests/final_heca_clinical_selected.tsv'
    stat_config='config/statistical_analysis.json'
    pre_effect_freeze='receipts/statistical_pre_effect_freeze.json'
    discovery_freeze='receipts/discovery_rank_freeze.json'
    evaluation_freeze=null
    synthetic_test=false
    outdir=null
    runtime_mode='native'
    container_image=null
}
workDir="${projectDir}/work/nextflow_replication"
process {
    executor='local'
    shell=['/bin/bash','-euo','pipefail']
    cpus=1
    memory='4 GB'
    maxForks=1
    errorStrategy='terminate'
    cache='deep'
    stageInMode='symlink'
}
executor.queueSize=1
profiles {
    srv01 {
        params.runtime_mode='native'
        docker.enabled=false
    }
    docker {
        params.runtime_mode='docker'
        docker.enabled=true
        docker.runOptions="-v ${projectDir}:${projectDir}:ro"
        process.container={params.container_image}
        process.containerOptions={"-v ${task.workDir}:${task.workDir}:rw"}
    }
}
