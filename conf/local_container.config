// Local-only overlay. Frozen workflows and historical freezes are unchanged.
profiles {
    local_container {
        def uid = System.getenv('ENDOTARGET_CONTAINER_UID')
        def gid = System.getenv('ENDOTARGET_CONTAINER_GID')
        def checkId = System.getenv('ENDOTARGET_LOCAL_CHECK_ID')
        if (uid != '1003' || gid != '1004' || !(checkId ==~ /[A-Za-z0-9_-]+/))
            throw new IllegalArgumentException('Local check requires UID1003/GID1004 and a bounded check ID')
        // Preserve candidate user/tmpfs isolation. Nextflow automatically mounts
        // project inputs read-only and the current task directory writable.
        // Do not duplicate those mount destinations in manual Docker options.
        docker.runOptions = "--user ${uid}:${gid} --read-only " +
            "--tmpfs /tmp:rw,nosuid,nodev,size=1g,mode=0700,uid=${uid},gid=${gid} " +
            "-e TMPDIR=/tmp -e HOME=/tmp -e XDG_CACHE_HOME=/tmp/.cache " +
            "--network none --memory 2g --cpus 1 --label endotarget.local-check=${checkId}"
        docker.writableInputMounts = false
        process.containerOptions = ''
        process.memory = '2 GB'
        process.cpus = 1
        process.maxForks = 1
        executor.queueSize = 1
        trace.fields = 'task_id,hash,name,status,exit,container,workdir'
    }
}
