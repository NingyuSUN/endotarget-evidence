// Candidate v1: NOT_BUILT_NOT_RUN. Combine with frozen docker profile.
profiles {
    statistics_container {
        docker.enabled = true
        docker.writableInputMounts = false
        def uid = System.getenv('ENDOTARGET_CONTAINER_UID')
        def gid = System.getenv('ENDOTARGET_CONTAINER_GID')
        if (!(uid ==~ /[0-9]+/) ||
            !(gid ==~ /[0-9]+/))
            throw new IllegalArgumentException('Export numeric ENDOTARGET_CONTAINER_UID and ENDOTARGET_CONTAINER_GID from host id')
        if (uid == '0')
            throw new IllegalArgumentException('Use the unprivileged project owner UID')
        docker.runOptions = "--user ${uid}:${gid} --read-only " +
            "--tmpfs /tmp:rw,nosuid,nodev,size=1g,mode=0700,uid=${uid},gid=${gid} " +
            "-e TMPDIR=/tmp -e HOME=/tmp -e XDG_CACHE_HOME=/tmp/.cache " +
            "-v ${projectDir}:${projectDir}:ro"
        process.container = { params.container_image }
        process.containerOptions = { "-v ${task.workDir}:${task.workDir}:rw" }
    }
}
